{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.4.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "BeatSaber Mods日本語化Mod",
    "id": "JapaneseLocalizer",
    "version": "0.2.1",
    "url": null,
    "additionalData": {
      "overrideSoName": "libJapaneseLocalizer.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": ["pwsh ./scripts/build.ps1 $0:?"],
      "clean": ["qpm s build -- -clean"],
      "qmod": ["pwsh ./scripts/createqmod.ps1 $0:?"],
      "validate": ["pwsh ./scripts/validate-modjson.ps1 $0:?"]
    },
    "ndk": "^27.3.13750724",
    "qmodIncludeDirs": ["build", "extern/libs"],
    "qmodIncludeFiles": [],
    "qmodOutput": "./JapaneseLocalizer.qmod"
  },
  "dependencies": [
    { "id": "beatsaber-hook", "versionRange": "^6.4.2", "additionalData": {} },
    { "id": "bs-cordl", "versionRange": "4008.*", "additionalData": {} },
    { "id": "bsml", "versionRange": "^0.4.55", "additionalData": { "private": true } },
    { "id": "custom-types", "versionRange": "^0.18.3", "additionalData": { "private": true } },
    { "id": "config-utils", "versionRange": "^2.0.3", "additionalData": { "private": true } },
    { "id": "paper2_scotland2", "versionRange": "^4.8.0", "additionalData": { "private": true } },
    { "id": "scotland2", "versionRange": "^0.1.6", "additionalData": { "includeQmod": false, "private": true } },
    { "id": "tinyxml2", "versionRange": "^10.0.0", "additionalData": { "private": true } }
  ]
}
